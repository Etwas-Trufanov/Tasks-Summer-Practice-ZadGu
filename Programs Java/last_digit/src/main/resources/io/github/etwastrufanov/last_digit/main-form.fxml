<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="222.0" prefWidth="207.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.etwastrufanov.last_digit.main_controller">

   <children>
      <Label layoutX="14.0" layoutY="44.0" text="Сторона" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="44.0" />
      <TextField fx:id="input_area" layoutX="14.0" layoutY="69.0" promptText="Введите сторону" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="69.0" />
      <Label layoutX="14.0" layoutY="110.0" prefHeight="18.0" prefWidth="111.0" text="Площадь" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="110.0" />
      <TextField fx:id="output_area" alignment="CENTER" editable="false" layoutX="14.0" layoutY="135.0" prefHeight="26.0" prefWidth="162.0" promptText="S" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="135.0" />
      <MenuBar layoutY="1.0" prefHeight="27.0" prefWidth="207.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="1.0">
        <menus>
          <Menu mnemonicParsing="false" text="Программа">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#on_menu_click" text="О программе" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <Button fx:id="CalcButton" layoutX="14.0" layoutY="175.0" mnemonicParsing="false" onMouseClicked="#on_calc_click" text="Расчитать" textAlignment="CENTER" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="175.0" />
   </children>
</AnchorPane>
